classDiagram
    class Task {
        +str description
        +time time
        +int duration
        +str frequency
        +str priority
        +int weekday
        +date due_date
        +date completed_on
        +is_due(day) bool
        +overlaps(other) bool
        +is_overdue(now) bool
        +next_occurrence() Task
        +mark_complete() void
        +is_completed() bool
    }

    class Pet {
        +str name
        +str species
        +int age
        +List~Task~ tasks
        +add_task(task) void
    }

    note for Pet "Pet must be added to its Owner first, or the Scheduler won't see its tasks"

    class Owner {
        +str name
        +List~Pet~ pets
        +add_pet(pet) void
        +add_task(pet, task) void
        +get_all_tasks() List~Tuple~
    }

    class Scheduler {
        +List~Owner~ owners
        +get_daily_schedule(now) List~Tuple~
        +sort_by_time(tasks) List~Tuple~
        +sort_tasks(tasks, now) List~Tuple~
        +pet_label(pet) str
        +filter_tasks(pet_name, completed) List~Tuple~
        +detect_conflicts(day) List~Tuple~
        +detect_owner_conflicts(day) List~Tuple~
        +suggest_free_slot(pet, task, day, owner_wide) time
    }

    Owner "1" --> "*" Pet : manages
    Pet "1" --> "*" Task : has
    Scheduler --> "*" Owner : reads get_all_tasks()
