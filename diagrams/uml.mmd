classDiagram
    class Owner {
        +str name
        +List~TimeWindow~ available_times
        +Dict~Pet, List~Task~~ tasks
        +add_pet(pet) void
        +add_task(pet, task) void
        +get_all_tasks() List~Tuple~
        +set_available_time(window) void
    }

    class Pet {
        +str name
        +str species
        +int age
    }

    class Task {
        +str title
        +TaskType task_type
        +int duration_minutes
        +Priority priority
        +time preferred_time
        +date completed_on
        +mark_complete() void
        +is_completed() bool
        +fits_in(window) bool
    }

    class TimeWindow {
        +time start
        +time end
        +duration() int
        +contains(time) bool
    }

    class Scheduler {
        +Owner owner
        +get_daily_schedule(pet) List~Task~
        +generate_daily_plan(pet) DailyPlan
        +sort_by_priority(tasks) List~Task~
        +fit_to_availability(tasks) List~ScheduledTask~
        +explain_choice(task) str
    }

    class ScheduledTask {
        +Task task
        +time start_time
        +time end_time
        +str reason
    }

    class DailyPlan {
        +Owner owner
        +Pet pet
        +date date
        +List~ScheduledTask~ scheduled
        +List~Task~ unscheduled
        +total_minutes() int
        +display() str
    }

    class TaskType {
        <<enumeration>>
        WALK
        FEEDING
        GROOMING
        MEDICATION
        PLAY
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    Owner "1" --> "*" Pet : owns
    Owner "1" --> "*" Task : prescribes (pet, task)
    Owner "1" --> "*" TimeWindow : available during
    Task --> TaskType
    Task --> Priority
    Scheduler --> Owner : reads
    Scheduler ..> DailyPlan : creates
    DailyPlan --> Owner
    DailyPlan --> Pet
    DailyPlan "1" o-- "*" ScheduledTask : contains
    ScheduledTask --> Task
