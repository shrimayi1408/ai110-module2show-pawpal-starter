classDiagram
    class Task {
        +str description
        +time time
        +str frequency
        +date completed_on
        +mark_complete() void
        +is_completed() bool
    }

    class Pet {
        +str name
        +str species
        +int age
        +List~Task~ tasks
        +add_task(task) void
    }

    note for Pet "Pet must be added to its Owner first, or the Scheduler won't see its tasks"

    class Owner {
        +str name
        +List~Pet~ pets
        +add_pet(pet) void
        +add_task(pet, task) void
        +get_all_tasks() List~Tuple~
    }

    class Scheduler {
        +Owner owner
        +get_daily_schedule() List~Tuple~
        +sort_by_time(tasks) List~Tuple~
        +filter_tasks(pet_name, completed) List~Tuple~
        +detect_conflicts() List~Tuple~
    }

    Owner "1" --> "*" Pet : manages
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : reads get_all_tasks()
